# ─────────────────────────────────────────────────────────────
# Akrostech website — environment variables
# Copy to `.env.local` for local development and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (used for metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://akrosstech.com

# Resend API key — https://resend.com/api-keys
# Required in production for the contact + newsletter forms.
RESEND_API_KEY=

# Where contact-form and newsletter notifications are delivered.
CONTACT_TO_EMAIL=gaurang@akrosstech.com

# Sender address. Must be on a domain verified in Resend
# (e.g. verify akrosstech.com, then use noreply@akrosstech.com).
# `onboarding@resend.dev` works for testing but only delivers to
# the email that owns the Resend account.
CONTACT_FROM_EMAIL="Akrostech Website <noreply@akrosstech.com>"
